<div class="aura-forge-shell">
  <aside class="aura-forge-library">
    <header>
      <h2>{{localize "PF2E_AURA_FORGE.Library"}}</h2>
      <button type="button" class="primary" data-action="newAura"><i class="fa-solid fa-plus"></i> {{localize "PF2E_AURA_FORGE.NewAura"}}</button>
    </header>
    <div class="aura-forge-library-list" data-preserve-scroll data-scroll-key="library">
      {{#if hasAuras}}
        {{#each auras as |aura|}}
          <button type="button" class="aura-library-entry {{#if aura.selected}}selected{{/if}}" data-action="selectAura" data-aura-id="{{aura.id}}">
            <i class="fa-solid fa-circle-nodes"></i><span>{{aura.name}}</span>
          </button>
        {{/each}}
      {{else}}
        <p class="aura-forge-muted">{{localize "PF2E_AURA_FORGE.NoAuras"}}</p>
      {{/if}}
    </div>
  </aside>

  <main class="aura-forge-main">
    <header class="aura-forge-toolbar">
      <div>
        <h1>{{localize "PF2E_AURA_FORGE.WindowTitle"}}</h1>
        <p class="aura-forge-api-status {{#unless apiReady}}error{{/unless}}">
          {{#if apiReady}}
            <i class="fa-solid fa-link"></i> Effect API {{effectApiVersion}} · Schema {{effectSchemaVersion}}
          {{else}}
            <i class="fa-solid fa-triangle-exclamation"></i> {{apiError}}
          {{/if}}
        </p>
      </div>
      <div class="aura-forge-dirty clean" data-dirty-indicator>
        <i class="fa-solid fa-circle"></i><span data-dirty-text>{{localize "PF2E_AURA_FORGE.AllChangesSaved"}}</span>
      </div>
    </header>

    <div class="aura-forge-scroll" data-aura-fields data-preserve-scroll data-scroll-key="main">
      <div class="aura-editor-host" data-aura-editor-host></div>

      <section class="aura-forge-section aura-editor-group group-actor-assignment actor-assignment-section" data-instance-controls>
        <header class="section-header section-titlebar">
          <div class="section-heading"><span class="section-heading-icon"><i class="fa-solid fa-users-gear"></i></span><div><h2>{{localize "PF2E_AURA_FORGE.ActorAssignment"}}</h2><p>{{localize "PF2E_AURA_FORGE.ActorAssignmentHint"}}</p></div></div>
        </header>
        {{#if selectedAuraId}}
          <div class="actor-assignment-controls">
            <label class="grow"><span>{{localize "PF2E_AURA_FORGE.Actor"}}</span>
              <select name="assignActorId" {{#unless canAssign}}disabled{{/unless}}>
                <option value="">{{localize "PF2E_AURA_FORGE.SelectActor"}}</option>
                {{#each actors as |actor|}}<option value="{{actor.id}}">{{actor.name}} ({{actor.type}})</option>{{/each}}
              </select>
            </label>
            <button type="button" data-action="assignAura" {{#unless canAssign}}disabled{{/unless}}><i class="fa-solid fa-user-plus"></i> {{localize "PF2E_AURA_FORGE.Assign"}}</button>
            <button type="button" data-action="assignSelectedToken" {{#unless canAssign}}disabled{{/unless}}><i class="fa-solid fa-bullseye"></i> {{localize "PF2E_AURA_FORGE.AssignSelectedToken"}}</button>
          </div>
          <div class="actor-drop-zone {{#unless canAssign}}disabled{{/unless}}" data-actor-drop-zone>
            <i class="fa-solid fa-user-plus"></i>
            <div><strong>{{localize "PF2E_AURA_FORGE.DropActor"}}</strong><span>{{localize "PF2E_AURA_FORGE.DropActorHint"}}</span></div>
          </div>
          <p class="aura-forge-muted" data-save-before-assign-hint {{#if canAssign}}hidden{{/if}}><i class="fa-solid fa-floppy-disk"></i> {{localize "PF2E_AURA_FORGE.SaveBeforeAssignHint"}}</p>
          {{#if hasAssignments}}
            <div class="actor-assignment-list">
              {{#each assignments as |entry|}}
                <div class="actor-assignment-row" data-actor-id="{{entry.actorId}}" data-instance-id="{{entry.instanceId}}">
                  <div class="actor-assignment-name"><i class="fa-solid fa-user-shield"></i><strong>{{entry.actorName}}</strong><small>{{entry.actorType}}</small></div>
                  <button type="button" data-action="toggleActorAura" data-actor-id="{{entry.actorId}}" data-instance-id="{{entry.instanceId}}" data-enabled="{{entry.enabled}}">
                    <i class="fa-solid {{#if entry.enabled}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i> {{#if entry.enabled}}{{localize "PF2E_AURA_FORGE.Active"}}{{else}}{{localize "PF2E_AURA_FORGE.Inactive"}}{{/if}}
                  </button>
                  <label class="radius-override"><span>{{localize "PF2E_AURA_FORGE.RadiusOverride"}}</span><input name="radiusOverride" type="number" min="1" step="5" value="{{entry.radiusOverride}}" placeholder="—"></label>
                  <button type="button" data-action="updateRadiusOverride" data-actor-id="{{entry.actorId}}" data-instance-id="{{entry.instanceId}}"><i class="fa-solid fa-check"></i></button>
                  <button type="button" class="danger" data-action="removeActorAura" data-actor-id="{{entry.actorId}}" data-instance-id="{{entry.instanceId}}"><i class="fa-solid fa-link-slash"></i></button>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="aura-forge-muted">{{localize "PF2E_AURA_FORGE.NoAssignments"}}</p>
          {{/if}}
        {{else}}
          <p class="aura-forge-muted">{{localize "PF2E_AURA_FORGE.SaveAuraToAssign"}}</p>
        {{/if}}
      </section>

    </div>

    <footer class="aura-forge-footer">
      <div>
        <button type="button" class="primary" data-action="saveAura"><i class="fa-solid fa-floppy-disk"></i> {{localize "PF2E_AURA_FORGE.Save"}}</button>
        <button type="button" data-action="duplicateAura"><i class="fa-regular fa-copy"></i> {{localize "PF2E_AURA_FORGE.Duplicate"}}</button>
        {{#if selectedAuraId}}<button type="button" class="danger" data-action="deleteAura"><i class="fa-solid fa-trash"></i> {{localize "PF2E_AURA_FORGE.Delete"}}</button>{{/if}}
      </div>
      <button type="button" data-action="closeWindow">{{localize "PF2E_AURA_FORGE.Close"}}</button>
    </footer>
  </main>
</div>
