<div class="aura-forge-shell">
  <aside class="aura-forge-library">
    <header>
      <h2>{{localize "PF2E_AURA_FORGE.Library"}}</h2>
      <button type="button" class="primary" data-action="newAura"><i class="fa-solid fa-plus"></i> {{localize "PF2E_AURA_FORGE.NewAura"}}</button>
    </header>
    <div class="aura-forge-library-list" data-preserve-scroll data-scroll-key="library">
      {{#if hasAuras}}
        {{#each auras as |aura|}}
          <button type="button" class="aura-library-entry {{#if aura.selected}}selected{{/if}}" data-action="selectAura" data-aura-id="{{aura.id}}">
            <i class="fa-solid fa-circle-nodes"></i><span>{{aura.name}}</span>
          </button>
        {{/each}}
      {{else}}
        <p class="aura-forge-muted">{{localize "PF2E_AURA_FORGE.NoAuras"}}</p>
      {{/if}}
    </div>
  </aside>

  <main class="aura-forge-main">
    <header class="aura-forge-toolbar">
      <div>
        <h1>{{localize "PF2E_AURA_FORGE.WindowTitle"}}</h1>
        <p class="aura-forge-api-status {{#unless apiReady}}error{{/unless}}">
          {{#if apiReady}}
            <i class="fa-solid fa-link"></i> Effect API {{effectApiVersion}} · Schema {{effectSchemaVersion}}
          {{else}}
            <i class="fa-solid fa-triangle-exclamation"></i> {{apiError}}
          {{/if}}
        </p>
      </div>
      <div class="aura-forge-dirty clean" data-dirty-indicator>
        <i class="fa-solid fa-circle"></i><span data-dirty-text>{{localize "PF2E_AURA_FORGE.AllChangesSaved"}}</span>
      </div>
    </header>

    <div class="aura-forge-scroll" data-aura-fields data-preserve-scroll data-scroll-key="main">
      <section class="aura-forge-section">
        <h2>{{localize "PF2E_AURA_FORGE.BasicData"}}</h2>
        <div class="aura-forge-grid two-columns">
          <label><span>{{localize "PF2E_AURA_FORGE.Name"}}</span><input name="auraName" type="text" value="{{draft.name}}" required></label>
          <label><span>{{localize "PF2E_AURA_FORGE.Radius"}}</span><input name="auraRadius" type="number" min="1" step="5" value="{{draft.radius}}"></label>
          <label><span>{{localize "PF2E_AURA_FORGE.AbilityId"}}</span><input name="auraAbilityId" type="text" value="{{draft.abilityId}}"></label>
          <label class="checkbox-row"><input name="auraEnabled" type="checkbox" {{#if draft.enabled}}checked{{/if}}><span>{{localize "PF2E_AURA_FORGE.Enabled"}}</span></label>
        </div>
        <label class="full-width"><span>{{localize "PF2E_AURA_FORGE.Description"}}</span><textarea name="auraDescription" rows="3">{{draft.description}}</textarea></label>
      </section>

      <section class="aura-forge-section">
        <h2>{{localize "PF2E_AURA_FORGE.Targeting"}}</h2>
        <div class="aura-forge-target-grid">
          <label class="checkbox-row"><input name="target-allies" type="checkbox" {{#if draft.targeting.allies}}checked{{/if}}><span>{{localize "PF2E_AURA_FORGE.Allies"}}</span></label>
          <label class="checkbox-row"><input name="target-enemies" type="checkbox" {{#if draft.targeting.enemies}}checked{{/if}}><span>{{localize "PF2E_AURA_FORGE.Enemies"}}</span></label>
          <label class="checkbox-row"><input name="target-neutral" type="checkbox" {{#if draft.targeting.neutral}}checked{{/if}}><span>{{localize "PF2E_AURA_FORGE.Neutral"}}</span></label>
          <label class="checkbox-row"><input name="target-source" type="checkbox" {{#if draft.targeting.source}}checked{{/if}}><span>{{localize "PF2E_AURA_FORGE.Source"}}</span></label>
        </div>
        <div class="aura-forge-grid two-columns">
          <label><span>{{localize "PF2E_AURA_FORGE.RequiredTraits"}}</span><input name="requiredTraits" type="text" value="{{draft.targeting.requiredTraits}}" placeholder="undead, mental"></label>
          <label><span>{{localize "PF2E_AURA_FORGE.ExcludedTraits"}}</span><input name="excludedTraits" type="text" value="{{draft.targeting.excludedTraits}}" placeholder="mindless"></label>
        </div>
      </section>

      <section class="aura-forge-section">
        <header class="section-header">
          <div><h2>{{localize "PF2E_AURA_FORGE.PresenceEffects"}}</h2><p>{{localize "PF2E_AURA_FORGE.PresenceEffectsHint"}}</p></div>
          <button type="button" data-action="addPresenceEffect"><i class="fa-solid fa-plus"></i> {{localize "PF2E_AURA_FORGE.AddPresenceEffect"}}</button>
        </header>
        <div class="aura-card-list">
          {{#each presenceEffects as |presence|}}
            <article class="aura-card" data-presence-id="{{presence.id}}">
              <div class="aura-card-row">
                <label class="grow"><span>{{localize "PF2E_AURA_FORGE.Label"}}</span><input name="presenceName" type="text" value="{{presence.name}}"></label>
                <div class="effect-chip {{#unless presence.hasEffect}}empty{{/unless}}">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  {{#if presence.hasEffect}}<span>{{presence.effectName}} · {{presence.componentCount}} {{localize "PF2E_AURA_FORGE.Components"}}</span>{{else}}<span>{{localize "PF2E_AURA_FORGE.NoEffect"}}</span>{{/if}}
                </div>
                <button type="button" data-action="editPresenceEffect" data-presence-id="{{presence.id}}"><i class="fa-solid fa-pen"></i> {{localize "PF2E_AURA_FORGE.EditEffect"}}</button>
                <button type="button" class="danger" data-action="removePresenceEffect" data-presence-id="{{presence.id}}"><i class="fa-solid fa-trash"></i></button>
              </div>
              {{#if presence.isEditing}}
                <div class="embedded-effect-inline" data-embedded-effect-panel>
                  <header class="embedded-effect-inline-header">
                    <strong><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "PF2E_AURA_FORGE.EmbeddedEffectEditor"}}</strong>
                    <button type="button" data-action="closeEmbeddedEditor"><i class="fa-solid fa-xmark"></i> {{localize "PF2E_AURA_FORGE.CloseEditor"}}</button>
                  </header>
                  <div data-embedded-effect-editor></div>
                </div>
              {{/if}}
            </article>
          {{/each}}
        </div>
      </section>

      <section class="aura-forge-section">
        <header class="section-header">
          <div><h2>{{localize "PF2E_AURA_FORGE.Triggers"}}</h2><p>{{localize "PF2E_AURA_FORGE.TriggersHint"}}</p></div>
          <button type="button" data-action="addTrigger"><i class="fa-solid fa-plus"></i> {{localize "PF2E_AURA_FORGE.AddTrigger"}}</button>
        </header>
        <div class="aura-card-list">
          {{#each triggers as |trigger|}}
            <article class="aura-card trigger-card" data-trigger-id="{{trigger.id}}">
              <header class="trigger-header">
                <label class="grow"><span>{{localize "PF2E_AURA_FORGE.Label"}}</span><input name="triggerName" type="text" value="{{trigger.name}}"></label>
                <label><span>{{localize "PF2E_AURA_FORGE.Event"}}</span><select name="triggerEvent">{{#each trigger.eventOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
                <button type="button" class="danger" data-action="removeTrigger" data-trigger-id="{{trigger.id}}"><i class="fa-solid fa-trash"></i></button>
              </header>

              <div class="trigger-config-grid">
                <div class="trigger-config-box">
                  <label class="checkbox-row"><input name="saveEnabled" type="checkbox" {{#if trigger.save.enabled}}checked{{/if}}><strong>{{localize "PF2E_AURA_FORGE.SavingThrow"}}</strong></label>
                  <div class="aura-forge-grid three-columns" data-save-config {{#unless trigger.save.enabled}}hidden{{/unless}}>
                    <label><span>{{localize "PF2E_AURA_FORGE.Type"}}</span><select name="saveType">{{#each trigger.saveTypeOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
                    <label><span>{{localize "PF2E_AURA_FORGE.DC"}}</span><input name="saveDc" type="number" min="1" value="{{trigger.save.dc.value}}"></label>
                    <label><span>{{localize "PF2E_AURA_FORGE.Mode"}}</span><select name="saveMode">{{#each trigger.saveModeOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
                  </div>
                </div>

                <div class="trigger-config-box">
                  <label class="checkbox-row"><input name="immunityEnabled" type="checkbox" {{#if trigger.immunity.enabled}}checked{{/if}}><strong>{{localize "PF2E_AURA_FORGE.TemporaryImmunity"}}</strong></label>
                  <div data-immunity-config {{#unless trigger.immunity.enabled}}hidden{{/unless}}>
                    <div class="aura-forge-grid three-columns">
                      <label><span>{{localize "PF2E_AURA_FORGE.Duration"}}</span><input name="immunityValue" type="number" min="1" value="{{trigger.immunity.duration.value}}"></label>
                      <label><span>{{localize "PF2E_AURA_FORGE.Unit"}}</span><select name="immunityUnit"><option value="rounds" {{#if (eq trigger.immunity.duration.unit "rounds")}}selected{{/if}}>{{localize "PF2E_AURA_FORGE.DurationUnits.rounds"}}</option><option value="minutes" {{#if (eq trigger.immunity.duration.unit "minutes")}}selected{{/if}}>{{localize "PF2E_AURA_FORGE.DurationUnits.minutes"}}</option><option value="hours" {{#if (eq trigger.immunity.duration.unit "hours")}}selected{{/if}}>{{localize "PF2E_AURA_FORGE.DurationUnits.hours"}}</option><option value="days" {{#if (eq trigger.immunity.duration.unit "days")}}selected{{/if}}>{{localize "PF2E_AURA_FORGE.DurationUnits.days"}}</option></select></label>
                      <label><span>{{localize "PF2E_AURA_FORGE.Scope"}}</span><select name="immunityScope">{{#each trigger.immunityScopeOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
                    </div>
                    <div class="degree-checkboxes">{{#each trigger.applyOn as |entry|}}<label class="checkbox-row"><input type="checkbox" data-immunity-degree="{{entry.degree}}" {{#if entry.checked}}checked{{/if}}><span>{{entry.label}}</span></label>{{/each}}</div>
                  </div>
                </div>
              </div>

              <div class="outcomes-grid">
                {{#each trigger.outcomes as |outcome|}}
                  <div class="outcome-card {{#if outcome.isEditing}}editing{{/if}}">
                    <strong>{{outcome.label}}</strong>
                    <span class="effect-chip {{#unless outcome.hasEffect}}empty{{/unless}}">{{#if outcome.hasEffect}}{{outcome.effectName}} · {{outcome.componentCount}} {{localize "PF2E_AURA_FORGE.Components"}}{{else}}{{localize "PF2E_AURA_FORGE.NoEffect"}}{{/if}}</span>
                    <div class="outcome-actions">
                      <button type="button" data-action="editOutcomeEffect" data-trigger-id="{{trigger.id}}" data-degree="{{outcome.degree}}"><i class="fa-solid fa-pen"></i></button>
                      {{#if outcome.hasEffect}}<button type="button" class="danger" data-action="clearOutcomeEffect" data-trigger-id="{{trigger.id}}" data-degree="{{outcome.degree}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}
                    </div>
                    {{#if outcome.isEditing}}
                      <div class="embedded-effect-inline outcome-effect-editor" data-embedded-effect-panel>
                        <header class="embedded-effect-inline-header">
                          <strong><i class="fa-solid fa-wand-magic-sparkles"></i> {{outcome.label}}</strong>
                          <button type="button" data-action="closeEmbeddedEditor"><i class="fa-solid fa-xmark"></i> {{localize "PF2E_AURA_FORGE.CloseEditor"}}</button>
                        </header>
                        <div data-embedded-effect-editor></div>
                      </div>
                    {{/if}}
                  </div>
                {{/each}}
              </div>
            </article>
          {{/each}}
        </div>
      </section>

      {{#if validation}}
        <section class="aura-forge-section validation-section">
          <h2>{{localize "PF2E_AURA_FORGE.Validation"}}</h2>
          {{#if hasValidationErrors}}<div class="validation-errors">{{#each validation.errors as |entry|}}<p><i class="fa-solid fa-circle-xmark"></i> {{entry.message}} <code>{{entry.path}}</code></p>{{/each}}</div>{{/if}}
          {{#if hasValidationWarnings}}<div class="validation-warnings">{{#each validation.warnings as |entry|}}<p><i class="fa-solid fa-triangle-exclamation"></i> {{entry.message}} <code>{{entry.path}}</code></p>{{/each}}</div>{{/if}}
        </section>
      {{/if}}
    </div>

    <footer class="aura-forge-footer">
      <div>
        <button type="button" class="primary" data-action="saveAura"><i class="fa-solid fa-floppy-disk"></i> {{localize "PF2E_AURA_FORGE.Save"}}</button>
        <button type="button" data-action="duplicateAura"><i class="fa-regular fa-copy"></i> {{localize "PF2E_AURA_FORGE.Duplicate"}}</button>
        {{#if selectedAuraId}}<button type="button" class="danger" data-action="deleteAura"><i class="fa-solid fa-trash"></i> {{localize "PF2E_AURA_FORGE.Delete"}}</button>{{/if}}
      </div>
      <button type="button" data-action="closeWindow">{{localize "PF2E_AURA_FORGE.Close"}}</button>
    </footer>
  </main>
</div>
